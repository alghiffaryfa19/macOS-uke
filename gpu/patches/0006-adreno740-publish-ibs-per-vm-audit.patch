+IOReturn NativeAdrenoVm::publishRange(uint64_t iova,size_t bytes) const
+{
+    if(!attached_ || poisoned_)return kIOReturnNotReady;
+    for(size_t i=0;i<high_;++i) {
+        const Mapping &m=mappings_[i];
+        if(!m.memory || iova<m.iova || iova-m.iova>=m.memory->bytes())continue;
+        if(coherentMapping(m.writeback))return kIOReturnSuccess;
+        const size_t first=(size_t)(iova-m.iova)&~(size_t)4095;
+        size_t end=((size_t)(iova-m.iova)+bytes+4095)&~(size_t)4095;
+        if(end>m.memory->bytes())end=m.memory->bytes();
+        return m.memory->publishForDevice(first,end-first,true,true,NativeAdrenoPhaseSubmit);
+    }
+    return kIOReturnBadArgument;
+}
+bool NativeAdrenoVm::gpuWord(uint64_t iova,uint32_t *word) const
+{
+    uint64_t d=0;unsigned level=0;
+    const uint64_t pa=walkDiag(iova,&d,&level);
+    return pa && native_adreno_dram_read32 && !native_adreno_dram_read32(pa,word);
 }
+unsigned NativeAdrenoVm::kindAt(uint64_t iova) const
+{
+    for(size_t i=0;i<high_;++i) {
+        const Mapping &m=mappings_[i];
+        if(!m.memory || iova<m.iova || iova-m.iova>=m.memory->bytes())continue;
+        return (m.memory->system()?1u:0u)|(m.memory->writeCombined()?2u:0u)|(m.memory->imported()?4u:0u)|
+            (m.memory->mapping()?8u:0u)|(coherentMapping(m.writeback)?16u:0u);
+    }
+    return 32u;
+}
