+#if defined(NATIVE_UFS_DRV_BYTES)
+// uke: raw reads of the DRV window outside IOStorage (the GPU firmware table sits in its GPT gap, before the volume).
+IOReturn NativeUfsBlock::readRaw (uint64_t offset, void *out, uint32_t length)
+{
+  if (!online) return kIOReturnNotReady;
+  if (!out || !length || ((offset | length) & 4095) || offset >= bytes || length > bytes - offset)
+    return kIOReturnBadArgument;
+  IOReturn result = kIOReturnSuccess;
+  IOLockLock (windowLock);
+  for (uint32_t done = 0; done < length && result == kIOReturnSuccess;) {
+    uint32_t chunk = length - done < kDataMax ? length - done : kDataMax;
+    result = hostRead4k (0, (absolute + offset + done) / 4096, chunk / 4096, bounce);
+    if (result == kIOReturnSuccess) memcpy (static_cast<uint8_t *> (out) + done, bounce, chunk);
+    done += chunk;
+  }
+  IOLockUnlock (windowLock);
+  return result;
 }
 
+extern "C" IOReturn native_ufs_drv_read (uint64_t offset, void *out, uint32_t length)
+{
+  NativeUfsBlock *window = gDrvWindow;
+  return window ? window->readRaw (offset, out, length) : kIOReturnNotReady;
+}
+#endif
