 // Transport read timing is independent of the optional VerifiedBlock policy.
 volatile uint64_t native_ufs_read_ticks = 0;
+// uke: block requests the system makes (all windows): [0..2] reads, bytes, ticks (lock wait included), [3..5] writes, bytes, ticks,
+// [6..8] media reads the RAM overlay path issued (commands, bytes, ticks), [9] longest read request in ticks. Ticks are CNTPCT (19.2 MHz).
+extern "C" {volatile uint64_t uke_ufs_io[10];}
 static inline uint64_t timerTicks (void) {uint64_t v; __asm__ volatile ("isb\n\tmrs %0, cntpct_el0" : "=r" (v)); return v;}
 
