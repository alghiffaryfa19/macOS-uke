+
+// uke: raw writes of the DRV window outside IOStorage, for UkeGpu's persistent pipeline cache. Only the range hostWrite4k admits
+// (gDrvWriteFirst..): never the GPT head or the firmware table. Forced unit access, so a completed write is on the medium.
+IOReturn NativeUfsBlock::writeRaw (uint64_t offset, const void *in, uint32_t length)
+{
+  if (!online) return kIOReturnNotReady;
+  if (!in || !length || ((offset | length) & 4095) || offset >= bytes || length > bytes - offset)
+    return kIOReturnBadArgument;
+  IOReturn result = kIOReturnSuccess;
+  IOLockLock (windowLock);
+  for (uint32_t done = 0; done < length && result == kIOReturnSuccess;) {
+    uint32_t chunk = length - done < kDataMax ? length - done : kDataMax;
+    memcpy (bounce, static_cast<const uint8_t *> (in) + done, chunk);
+    result = hostWrite4k (0, (absolute + offset + done) / 4096, chunk / 4096, bounce, true);
+    done += chunk;
+  }
+  IOLockUnlock (windowLock);
+  return result;
+}
+
+extern "C" IOReturn native_ufs_drv_write (uint64_t offset, const void *in, uint32_t length)
+{
+  NativeUfsBlock *window = gDrvWindow;
+  return window ? window->writeRaw (offset, in, length) : kIOReturnNotReady;
 }
