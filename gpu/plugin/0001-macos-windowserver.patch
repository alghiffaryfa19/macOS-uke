+#define UKE_ACCELERATOR_CLASS "IOAccelerator"
+#define UKE_RENDER_CACHE_LEAF "com.apple.WindowServer"
+#define UKE_FALLBACK_CACHE "/private/var/tmp/m2v"
+#else
+#define UKE_RENDER_SERVER "backboardd"
+#define UKE_ACCELERATOR_CLASS "IOAcceleratorES"
+#define UKE_RENDER_CACHE_LEAF "com.apple.backboardd"
+#define UKE_FALLBACK_CACHE "/var/mobile/tmp/m2v"
+#endif
