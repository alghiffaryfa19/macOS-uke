diff --git a/UkeRenderServer.h b/UkeRenderServer.h
new file mode 100644
index 0000000..11e0da4
--- /dev/null
+++ b/UkeRenderServer.h
@@ -0,0 +1,17 @@
+// SPDX-License-Identifier: MIT
+// uke macOS 26.5: the process that owns the GPU and the IOKit class the kernel publishes differ from iPadOS. On macOS the
+// render server is WindowServer and the accelerator is UkeGpu's AGXAccelerator, an IOAccelerator (boot/macos-gpu), not
+// IOAcceleratorES; the Metal discovery (MTLIOAccelServiceGlobalContext) matches IOAccelerator.
+#pragma once
+#include <TargetConditionals.h>
+#if TARGET_OS_OSX
+#define UKE_RENDER_SERVER "WindowServer"
+#define UKE_ACCELERATOR_CLASS "IOAccelerator"
+#define UKE_RENDER_CACHE_LEAF "com.apple.WindowServer"
+#define UKE_FALLBACK_CACHE "/private/var/tmp/m2v"
+#else
+#define UKE_RENDER_SERVER "backboardd"
+#define UKE_ACCELERATOR_CLASS "IOAcceleratorES"
+#define UKE_RENDER_CACHE_LEAF "com.apple.backboardd"
+#define UKE_FALLBACK_CACHE "/var/mobile/tmp/m2v"
+#endif
