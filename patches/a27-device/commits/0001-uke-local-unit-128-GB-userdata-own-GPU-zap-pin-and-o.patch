Subject: [PATCH 1/4] uke (local unit): 128 GB userdata, own GPU zap pin and
 own owner boot-set identity

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 board.toml                       | 6 +++---
 package/OwnerBootIdentity.h      | 7 ++++---
 proprietary-files.txt            | 2 +-
 scripts/data/uke-gpu-inputs.json | 2 +-
 scripts/prepare-uke-gmu.py       | 2 +-
 5 files changed, 10 insertions(+), 9 deletions(-)

diff --git a/board.toml b/board.toml
index 37bdc52..98d69d8 100644
--- a/board.toml
+++ b/board.toml
@@ -29,7 +29,7 @@ include = [
 # first_lba and last_lba are the GPT entry "userdata" of LUN 0, read from the tablet.
 [userdata]
 first_lba = 0x2d3000
-last_lba = 0x3b147fa
+last_lba = 0x1d497fa
 lba_bytes = 4096
 # ShengUfs requires distinct OS and SystemOS windows; both are present in 24A446.
 # Raw hash tables only: --object OS.vroot=<OS>/manifest.bin:544 and SystemOS.vroot=<SystemOS>/manifest.bin:544.
@@ -137,7 +137,7 @@ sha256 = "435c7bac9a328b8a100df930b84b65b4d579e42be44785d0e60e3729291bb864"
 
 [gpu.firmware_pins."gen71100_zap.mbn"]
 bytes = 12088
-sha256 = "1294992888e8c7c7fcd8a6d0a672cc666eff3c95e666ce5840db7e03edcc500d"
+sha256 = "73e07ec2192bd9e1dbd404324fd4226c31c68b0e03b4623cacced3369c32cd2b"
 
 # The kernel prelink input (tool, kernelcache sha, slide, early_security_init and roots) comes from
 # the `ipados-27.0.1-24A446` profile: the 24A446 kernelcache is an MH_FILESET with stripped symbols,
@@ -338,7 +338,7 @@ embedded-panic-log-size = 0x380000
 # Owner image-set identity, derived from the fully verified signed OS/SystemOS policies.
 # This is explicitly owner-domain metadata, not an Apple ticket identity.
 [adt.chosen.bytes]
-boot-manifest-hash = "148316f0bb4484b19cda323503ffcb454fcc96d089087cd1f140725337c7cb8c435b86e560c193df76821ca121e262e9"
+boot-manifest-hash = "f48f171362f351e56fec35ce2d7c16cdb0daec37b57a58587417ff245a98ca3c8790734e271efc4e6387c20644586f6c"
 owner-boot-manifest-domain = "5665726966696564526f6f742e4f776e6572426f6f745365742e763100"
 
 [adt.defaults.u32]
