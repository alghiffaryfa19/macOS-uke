From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Daniel <daniel@Mac-mini-de-Daniel.local>
Date: Tue, 3 Nov 2026 23:39:02 +0100
Subject: [PATCH 4/4] uke: fence static high DRAM that the live DT does not
 describe as usable

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../UkeBootMemoryDxe/UkeBootMemoryDxe.c       | 63 +++++++++++++++++++
 1 file changed, 63 insertions(+)

diff --git a/Platforms/Xiaomi/ukePkg/Drivers/UkeBootMemoryDxe/UkeBootMemoryDxe.c b/Platforms/Xiaomi/ukePkg/Drivers/UkeBootMemoryDxe/UkeBootMemoryDxe.c
index 21c59c3f..690db03d 100644
--- a/Platforms/Xiaomi/ukePkg/Drivers/UkeBootMemoryDxe/UkeBootMemoryDxe.c
+++ b/Platforms/Xiaomi/ukePkg/Drivers/UkeBootMemoryDxe/UkeBootMemoryDxe.c
@@ -221,6 +221,69 @@ AddMemory (
     return;
   }
 
+  //
+  // MemoryMapLib declares the high banks statically from a 12 GB unit's DT (one 9 GiB run up to 0xB00000000).
+  // On a unit whose live DT has less DRAM there, or reserves part of it, those pages fault when touched (a
+  // DarwinBoot file read at 0xAFD229000 took a synchronous external abort). Fence every free page of that
+  // static system memory that the live DT does not describe as usable DRAM, so nothing allocates from it.
+  //
+  for (Other = 0; Other < MapCount; Other++) {
+    if ((Map[Other].GcdMemoryType != EfiGcdMemoryTypeSystemMemory) || (Map[Other].BaseAddress < SIZE_4GB)) {
+      continue;
+    }
+
+    Pieces[0].Base = Map[Other].BaseAddress;
+    Pieces[0].End  = Map[Other].BaseAddress + Map[Other].Length;
+    PieceCount     = 1;
+    for (Index = 0; Index < BankCount; Index++) {
+      PieceCount = Subtract (Pieces, PieceCount, Banks[Index]);
+    }
+
+    for (Index = 0; Index < ReservedCount; Index++) {
+      if (ReservedRanges[Index].End > Map[Other].BaseAddress) {
+        RANGE  Cut[MAX_RANGES];
+        UINTN  CutCount;
+
+        Cut[0]   = ReservedRanges[Index];
+        CutCount = 1;
+        CutCount = Subtract (Cut, CutCount, (RANGE){ 0, Map[Other].BaseAddress });
+        CutCount = Subtract (Cut, CutCount, (RANGE){ Map[Other].BaseAddress + Map[Other].Length, MAX_UINT64 });
+        if ((CutCount == 1) && (PieceCount < MAX_RANGES)) {
+          Pieces[PieceCount++] = Cut[0];
+        }
+      }
+    }
+
+    for (Index = 0; Index < PieceCount; Index++) {
+      UINT64  Chunk = Pieces[Index].Base & ~((UINT64)EFI_PAGE_SIZE - 1);
+      UINT64  Fenced = 0;
+
+      // Whole 2 MiB chunks where they are free, page by page only where something already holds part of one.
+      while (Chunk < Pieces[Index].End) {
+        UINT64                ChunkEnd = MIN (ALIGN_VALUE (Chunk + 1, SIZE_2MB), Pieces[Index].End);
+        EFI_PHYSICAL_ADDRESS  Address  = Chunk;
+        UINT64                Page;
+
+        if (!EFI_ERROR (gBS->AllocatePages (AllocateAddress, EfiReservedMemoryType,
+                                            EFI_SIZE_TO_PAGES (ChunkEnd - Chunk), &Address))) {
+          Fenced += ChunkEnd - Chunk;
+        } else {
+          for (Page = Chunk; Page < ChunkEnd; Page += EFI_PAGE_SIZE) {
+            Address = Page;
+            if (!EFI_ERROR (gBS->AllocatePages (AllocateAddress, EfiReservedMemoryType, 1, &Address))) {
+              Fenced += EFI_PAGE_SIZE;
+            }
+          }
+        }
+
+        Chunk = ChunkEnd;
+      }
+
+      DEBUG ((DEBUG_ERROR, "UKEMEM: fenced 0x%lx bytes of 0x%lx-0x%lx (not usable DRAM in the live DT)\n",
+              Fenced, Pieces[Index].Base, Pieces[Index].End));
+    }
+  }
+
   //
   // Holes: DRAM the GCD does not know yet.
   //
