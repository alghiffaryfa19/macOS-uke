-              node('ufshc', [('compatible', b'qcom,sm8550-ufshc\0')])]),
+              node('ufshc', [('compatible', b'qcom,sm8550-ufshc\0')]),
+              # GPU (Adreno 732) and GMU: the driver reads gpu-memory-base
+              # and gpu-memory-size to locate the pre-reserved contiguous region.
+              *([node('gpu', [('compatible', b'qcom,adreno-gpu-gen7-11-0\0'),
+                               ('reg', struct.pack('<QQ', GPU_BASE, GPU_SIZE)),
+                               ('gpu-memory-base', struct.pack('<Q', gpu_mem_base)),
+                               ('gpu-memory-size', struct.pack('<Q', gpu_mem_size))]),
+                 node('gmu', [('compatible', b'qcom,adreno-gmu-732\0'),
+                               ('reg', struct.pack('<QQ', GMU_BASE, GMU_SIZE))])]
+                if gpu_mem_size else [])]),
     ])
