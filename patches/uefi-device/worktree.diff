diff --git a/board.toml b/board.toml
index 4f921dd..55b3a91 100644
--- a/board.toml
+++ b/board.toml
@@ -1,10 +1,10 @@
-# Board description of the Xiaomi Pad 6S Pro (sheng, SM8550), read by the unixnu build driver.
+# Board description of the Xiaomi Pad 7 (uke, SM7675), read by the unixnu build driver.
 
 [board]
 name = "uke"
 soc = "SM7675"
 description = "Xiaomi Pad 7"
-kit = "uke"                      # the package/ of this repository appears as kits/sheng in the build tree
+kit = "uke"                      # the package/ of this repository appears as kits/uke in the build tree
 
 # The target OS image: the unchanged iPad7,1 iPadOS 17.7.11 restore image. Give --ipsw PATH to use a local file; without
 # it the remote url is read with range requests, only the members that are needed.
@@ -26,7 +26,7 @@ fetch = ["KernelCache", "DeviceTree", "StaticTrustCache", "Cryptex1,SystemTrustC
 # first_lba and last_lba are the GPT entry "userdata" of LUN 0, read from the tablet.
 [userdata]
 first_lba = 0x2d3000
-last_lba = 0x3b147fa
+last_lba = 0x1d497fa
 lba_bytes = 4096
 windows = [
   { name = "OS", component = "OS" },
@@ -54,6 +54,7 @@ archives = [
   "build-libpthread-kernel.py",
   "build-native-legacy-display.py",
   "build-boot-log.py",
+  "build-ath12k-wifi.py",
 ]
 
 # Adreno 732 (uke) board values for the native GPU driver. The driver currently
@@ -227,6 +228,8 @@ kernel_args = [
   "armcpu-spi-ipi=1",
   "-no_slto_panic",
   "ml-timeout-lock-panic-scale=40",
+  "uke-wifi=1",
+  "sheng-touch=4",
 ]
 # Fixups of signed text, applied by the kernel after signature validation (patches/xnu/native-text-fixup.patch); they reach it as
 # /chosen/text-fixups, not on the command line. Each is <file name>,<file offset>,<original>,<replacement>, in hex. uke runs the
@@ -237,11 +240,14 @@ text_fixups = [
   "dyld_shared_cache_arm64.15,421e8bc,28ad1bb0008544f9,c0035fd6008544f9",
   "dyld_shared_cache_arm64.13,1b05bec,44008052,24008052",
   "dyld_shared_cache_arm64.13,1b05b08,44008052,24008052",
-  # BTAudioHALPlugin's factory returns NULL, so audiomxd skips it: with bluetoothd disabled (sheng-lite) the plugin reconnects to the
+  # BTAudioHALPlugin's factory returns NULL, so audiomxd skips it: with bluetoothd disabled (uke-lite) the plugin reconnects to the
   # audio device and hangs audiomxd's startup (int-141), which keeps the speaker from ever being ready.
   "BTAudioHALPlugin,38bec,ffc300d1f44f01a9,000080d2c0035fd6",
 ]
 
+[components]
+include = ["ArmDTPlatform", "ArmCpu", "NativeAES", "NativeUfs", "NativeRamBlock", "Adreno732", "AdrenoMetal", "GopFramebuffer", "ShengHidInput", "NativeNovatekTouch", "QcomGeniSpi", "AppleKeyStoreState", "XnuPrelink", "DarwinBoot", "VerifiedRoot", "UkePreflight", "AirNir", "Ath12kWifi"]
+
 [payload.adt]
 tool = "scripts/make-uke-adt.py"
 chip_id = "207"
@@ -253,7 +259,7 @@ root_match_volume_uuid = "04769D26-2CA0-4825-B443-E2E5F88300F2"
 boot_manifest_hash = "5fd2fc139b688ddf071aa815c1ea75d26bcd994a528cf02e365661eab5139ec7b580d63ca9319e218962a2236f23faca"
 cpu_regs = "0,0x100,0x200,0x300,0x400,0x500,0x600,0x700"
 packed_data_ramdisk = true
-persistent_data = true               # sheng-data-persist keeps Data writes, so Data is not ephemeral storage
+persistent_data = true               # uke-data-persist keeps Data writes, so Data is not ephemeral storage
 ipad_identity = true
 unique_chip_id = "required"          # the platform seed is not stored in any repository
 
