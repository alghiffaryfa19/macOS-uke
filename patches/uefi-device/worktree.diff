diff --git a/scripts/make-uke-adt.py b/scripts/make-uke-adt.py
index 3548279..6bc6c7f 100755
--- a/scripts/make-uke-adt.py
+++ b/scripts/make-uke-adt.py
@@ -42,6 +42,17 @@ UFS_PHY_SIZE = 0x2000
 # llcc_lpi_region@ff800000 reservation.
 PANIC_LOG_BASE = 0xFF800000
 PANIC_LOG_SIZE = 0x00380000
+# GPU contiguous memory reservation: the Adreno 732 GMU stage 4 calls
+# vm_page_find_contiguous() which fails because XNU cannot find a large
+# enough free physically contiguous region. Fix: pre-reserve 8 MiB and
+# have the GPU driver adopt it via IODeviceMemory::withRange().
+# Values: gmem 0x180000 + preempt 0x418000 + GMU buffers ~0x200000 ≈ 7.7 MiB → 8 MiB.
+GPU_MEM_SIZE = 0x00800000  # 8 MiB
+# GPU register bases (from board.toml [gpu] section)
+GPU_BASE = 0x3d00000
+GPU_SIZE = 0x40000
+GMU_BASE = 0x3d68000
+GMU_SIZE = 0x37000
 
 
 def node(name, properties=(), children=()):
@@ -99,6 +110,10 @@ def main():
                              'SM7675 numbers its cores 0x000..0x700 in Affinity1 (sm8550.dtsi). More than one adds /psci')
     parser.add_argument('--psci-method', choices=['smc', 'hvc'], default='smc',
                         help='/psci method used by the secondary-CPU start (the board DT declares smc)')
+    parser.add_argument('--gpu-reserved-size', type=lambda value: int(value, 0), default=GPU_MEM_SIZE,
+                        help='GPU contiguous memory reservation in bytes (default 8 MiB); 0 disables')
+    parser.add_argument('--gpu-reserved-base', type=lambda value: int(value, 0), default=None,
+                        help='Explicit GPU reserved base address; default: top of owned DRAM')
     parser.add_argument('--packed-data-ramdisk', action='store_true', help='Hand off validated DBRDISK1 bytes to the native sparse block driver, without a dense memdev alias')
     parser.add_argument('--data-ramdisk', action='store_true',
                         help='/chosen/memory-map RAMDisk placeholder; the loader fills in the real range for a scratch Data seed')
@@ -127,6 +142,14 @@ def main():
             or args.owned_memory_size % 0x200000):
         parser.error('Owned memory must be 256 MiB to 8 GiB, aligned to 2 MiB')
 
+    gpu_mem_base = args.gpu_reserved_base
+    gpu_mem_size = args.gpu_reserved_size
+    if gpu_mem_size and not gpu_mem_base:
+        # Carve from the top of the owned DRAM range
+        owned = args.owned_memory_size or 0x10000000
+        gpu_mem_base = args.dram_base + owned - gpu_mem_size
+        gpu_mem_base &= ~0x1FFFFF  # 2 MiB aligned
+
     try:
         cpu_regs = [int(value, 0) for value in args.cpu_regs.split(',')]
     except ValueError:
@@ -222,6 +245,17 @@ def main():
                              ('artwork-display-gamut', b'P3\0'),
                              ('compatible-device-fallback', b'iPad6,7\0'),
                              ('thin-bezel', struct.pack('<I', 1))] if args.ipad_identity else [] )]),
+        # GPU contiguous memory reservation: the GMU needs physically contiguous
+        # pages that vm_page_find_contiguous() cannot satisfy from fragmented free
+        # lists. This node lets the GPU driver adopt the range with
+        # IODeviceMemory::withRange() instead.
+        *([node('reserved-memory', [('#address-cells', struct.pack('<I', 2)),
+                                     ('#size-cells', struct.pack('<I', 2)),
+                                     ('ranges', b'')],
+                [node('gpu-memory', [('reg', struct.pack('<QQ', gpu_mem_base, gpu_mem_size)),
+                                      ('no-map', b''),
+                                      ('compatible', b'qcom,adreno-smmu-guard\0')])])]
+          if gpu_mem_size else []),
         node('arm-io', [('device_type', b'arm-io\0'),
                         ('#address-cells', struct.pack('<I', 2)),
                         ('#size-cells', struct.pack('<I', 2)),
@@ -231,10 +265,16 @@ def main():
                                                 GIC_DIST - ARMIO_BASE, GIC_DIST_SIZE,
                                                 GIC_REDIST - ARMIO_BASE, GIC_REDIST_SIZE)),
                             ('redistributor-stride', struct.pack('<Q', 0x40000))]),
-              # UFS (0x1d84000) lies below the arm-io window, so a child reg offset would be
