@@ -34,6 +42,15 @@ static bool ufsRecoveryRootUuid (const char *name, uint64_t bytes, char out[37])
     memcpy (out, isc, sizeof (isc));
     return true;
   }
+#endif
+#if defined(NATIVE_UFS_DRV_BYTES)
+  // Only for the distinct-identity check of the publisher; DRV publication never waits for this UUID.
+  static const char drv[] = NATIVE_UFS_DRV_UUID;
+  static_assert (sizeof (drv) == 37, "requires the DRV window UUID");
+  if (!strcmp (name, "DRV") && bytes == NATIVE_UFS_DRV_BYTES) {
+    memcpy (out, drv, sizeof (drv));
+    return true;
+  }
 #endif
