     return !memcmp (digest, isc, sizeof (isc));
+#endif
+#if defined(NATIVE_UFS_DRV_BYTES)
+  // uke: the DRV window is rewritten in place (dd from recovery), so its manifest digest is all zeros, never checked.
+  if (!strcmp (name, "DRV") && bytes == NATIVE_UFS_DRV_BYTES) {
+    uint8_t any = 0;
