diff --git a/platform/sheng/macos26/log/early_exception.h b/platform/sheng/macos26/log/early_exception.h
index 03ca922..1c8bf06 100644
--- a/platform/sheng/macos26/log/early_exception.h
+++ b/platform/sheng/macos26/log/early_exception.h
@@ -32,6 +32,8 @@ Lsheng_early_enter:
 
 Lsheng_early_exception:
 	msr DAIFSet, #15
+	/* uke: a secondary core records its own fault, with the MMU on or off, and parks (sheng_smp_entry.h). */
+	SHENG_SMP_EXCEPTION
 	/* Use V=P vectors for the first MMU transition without high mappings or an exception stack. */
 	mrs x0, SCTLR_EL1
