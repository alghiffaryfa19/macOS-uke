diff --git a/platform/sheng/macos26/log/smp_log.h b/platform/sheng/macos26/log/smp_log.h
index 55e34bb..2092a94 100644
--- a/platform/sheng/macos26/log/smp_log.h
+++ b/platform/sheng/macos26/log/smp_log.h
@@ -6,10 +6,27 @@ extern volatile int32_t armcpu_smp_psci_rc[8];
 extern volatile uint32_t armcpu_smp_mpidr[8], armcpu_smp_seen_mpidr[8];
 extern volatile uint32_t armcpu_core_timer[8], armcpu_core_sgi[8];
 extern volatile uint64_t armcpu_ipi_sent, armcpu_ipi_interrupts;
+/* uke: osfmk/arm64/sheng_smp_entry.h, written by the secondaries partly with the MMU off. */
+extern volatile uint64_t sheng_smp_entry[64];
 unsigned sheng_smp_log_cpus;
 static uint32_t sheng_smp_log_writer;
 static uint64_t sheng_smp_log_reported;
-static uint32_t sheng_smp_log_valid, sheng_smp_log_previous[8][3];
+static uint32_t sheng_smp_log_valid, sheng_smp_log_previous[8][4];
+
+/* A secondary writes its line non-cacheable before its MMU is on: drop any copy this core holds first. */
+static uint64_t sheng_smp_entry_read(unsigned cpu, unsigned field)
+{
+    volatile uint64_t *line = &sheng_smp_entry[cpu * 8];
+    __asm__ volatile ("dc civac, %0\n\tdsb sy" :: "r" (line) : "memory");
+    return line[field];
+}
+
+/* The boot CPU's own stage 1 translation of va (PAR_EL1) and its TTBR1, to compare with a secondary's fault. */
+static void sheng_smp_boot_translate(uint64_t va, uint64_t *par, uint64_t *ttbr1)
+{
+    __asm__ volatile ("at s1e1r, %2\n\tisb\n\tmrs %0, par_el1\n\tmrs %1, ttbr1_el1"
+        : "=r" (*par), "=r" (*ttbr1) : "r" (va) : "memory");
+}
 
 static void sheng_smp_field(char *line, unsigned *n, const char *name, uint64_t value)
 {
@@ -32,13 +49,14 @@ static void sheng_smp_log_tick(void)
     if (!__atomic_compare_exchange_n(&sheng_smp_log_writer, &expected, 1, 0,
         __ATOMIC_ACQUIRE, __ATOMIC_RELAXED)) return;
     uint64_t now = sheng_boot_progress_seconds();
-    uint32_t state[8][3];
+    uint32_t state[8][4];
     int changed = !sheng_smp_log_valid;
     for (unsigned cpu = 0; cpu < sheng_smp_log_cpus; cpu++) {
         state[cpu][0] = __atomic_load_n(&armcpu_smp_step[cpu], __ATOMIC_RELAXED);
         state[cpu][1] = __atomic_load_n(&armcpu_smp_fail[cpu], __ATOMIC_RELAXED);
         state[cpu][2] = (uint32_t)__atomic_load_n(&armcpu_smp_psci_rc[cpu], __ATOMIC_RELAXED);
-        for (unsigned i = 0; i < 3; i++) changed |= state[cpu][i] != sheng_smp_log_previous[cpu][i];
+        state[cpu][3] = (uint32_t)sheng_smp_entry_read(cpu, 0);
+        for (unsigned i = 0; i < 4; i++) changed |= state[cpu][i] != sheng_smp_log_previous[cpu][i];
     }
     if (!changed && (now < sheng_smp_log_reported || now - sheng_smp_log_reported < 30)) {
         __atomic_store_n(&sheng_smp_log_writer, 0, __ATOMIC_RELEASE);
@@ -77,7 +95,44 @@ static void sheng_smp_log_tick(void)
         sheng_smp_field(line, &n, " timer=", __atomic_load_n(&armcpu_core_timer[cpu], __ATOMIC_RELAXED));
         sheng_smp_field(line, &n, " ipi=", __atomic_load_n(&armcpu_core_sgi[cpu], __ATOMIC_RELAXED));
         sheng_smp_emit(line);
-        for (unsigned i = 0; i < 3; i++) sheng_smp_log_previous[cpu][i] = state[cpu][i];
+        if (cpu != 0) {
+            /* entry: 1-12 assembly (reset vector .. trampoline; x0 = trampoline KVA), 16-22 arm_init_cpu, 224 reset handler gave up, 238 exception. */
+            n = 0;
+            sheng_smp_field(line, &n, "cpu=", cpu);
+            sheng_smp_field(line, &n, " entry=", state[cpu][3]);
+            sheng_smp_field(line, &n, " el=", sheng_smp_entry_read(cpu, 5) >> 2);
+            sheng_smp_field(line, &n, " sctlr=", sheng_smp_entry_read(cpu, 6));
+            sheng_smp_field(line, &n, " x0=", sheng_smp_entry_read(cpu, 7));
+            sheng_smp_emit(line);
+            /* A fault is kept once recorded: the core may have retried past it (retries = field 7). */
+            if (sheng_smp_entry_read(cpu, 1) != 0) {
+                n = 0;
+                sheng_smp_field(line, &n, "cpu=", cpu);
+                sheng_smp_field(line, &n, " fault-at=", sheng_smp_entry_read(cpu, 4));
+                sheng_smp_field(line, &n, " esr=", sheng_smp_entry_read(cpu, 1));
+                sheng_smp_field(line, &n, " elr=", sheng_smp_entry_read(cpu, 2));
+                sheng_smp_field(line, &n, " retries=", sheng_smp_entry_read(cpu, 7));
+                sheng_smp_emit(line);
+                const uint64_t far = sheng_smp_entry_read(cpu, 3);
+                n = 0;
+                sheng_smp_field(line, &n, "cpu=", cpu);
+                sheng_smp_field(line, &n, " far=", far);
+                sheng_smp_field(line, &n, " parked-esr=", sheng_smp_entry_read(cpu, 5));
+                sheng_smp_emit(line);
+                uint64_t boot_par, boot_ttbr1;
+                sheng_smp_boot_translate(far, &boot_par, &boot_ttbr1);
+                n = 0;
+                sheng_smp_field(line, &n, "cpu=", cpu);
+                sheng_smp_field(line, &n, " ttbr1=", sheng_smp_entry_read(cpu, 6));
+                sheng_smp_field(line, &n, " boot-ttbr1=", boot_ttbr1);
+                sheng_smp_emit(line);
+                n = 0;
+                sheng_smp_field(line, &n, "cpu=", cpu);
+                sheng_smp_field(line, &n, " boot-par=", boot_par);
+                sheng_smp_emit(line);
+            }
+        }
+        for (unsigned i = 0; i < 4; i++) sheng_smp_log_previous[cpu][i] = state[cpu][i];
     }
     __atomic_store_n(&sheng_smp_log_writer, 0, __ATOMIC_RELEASE);
 }
diff --git a/platform/sheng/macos26/pac/smp_entry.h b/platform/sheng/macos26/pac/smp_entry.h
new file mode 100644
index 0000000..d6ee0c7
--- /dev/null
+++ b/platform/sheng/macos26/pac/smp_entry.h
@@ -0,0 +1,139 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// uke: where each secondary core got to on its way from PSCI CPU_ON to ArmCpu::initCPU.
+// One 64-byte line per core, indexed by MPIDR Aff1 (the core number on SM7675):
+//   [0] last stage reached   [8] ESR   [16] ELR   [24] FAR   [32] stage when the exception hit
+//   [40] CurrentEL at entry (after an exception: the ESR of the exception that parked the core, 0 if none)
+//   [48] SCTLR_EL1 at entry (TTBR1_EL1 after an exception)   [56] x0 when the reset handler gave up
+// Stages 1-12 are written from assembly, before and after the MMU is enabled (12: arrived in arm_init_tramp,
+// 11: phystokv returned there); 16-22 from arm_init_cpu. Field [56] also holds the trampoline address from stage 10.
+// A secondary keeps the V=P vectors until stage 11, so a fault anywhere before it is recorded as stage 0xee.
+// Before the MMU is on the stores are non-cacheable, so the reader invalidates each line first.
+// Initialized data survives arm_init's BSS clearing.
+.data
+.p2align 6
+.globl EXT(sheng_smp_entry)
+EXT(sheng_smp_entry):
+    .space 512, 0
+.text
+
+.macro SHENG_SMP_ENTRY_LINE
+    mrs x16, MPIDR_EL1
+    ubfx x16, x16, #8, #3
+#ifdef __APPLE__
+    adrp x17, EXT(sheng_smp_entry)@page
+    add x17, x17, EXT(sheng_smp_entry)@pageoff
+#else
+    adrp x17, EXT(sheng_smp_entry)
+    add x17, x17, :lo12:EXT(sheng_smp_entry)
+#endif
+    add x17, x17, x16, lsl #6
+.endmacro
+
+// Secondary-only paths (reset vector, start_cpu). Clobbers x16 and x17.
+.macro SHENG_SMP_MARK stage
+    SHENG_SMP_ENTRY_LINE
+    mov x16, #\stage
+    str x16, [x17]
+    dsb sy
+.endmacro
+
+// Paths shared with the cold boot CPU (common_start): only a warm start (x21 != 0) records.
+.macro SHENG_SMP_MARK_WARM stage
+    cbz x21, 9f
+    SHENG_SMP_MARK \stage
+9:
+.endmacro
+
+// First instructions of the reset vector: also record the exception level and SCTLR the core was started with.
+.macro SHENG_SMP_MARK_ENTRY
+    SHENG_SMP_ENTRY_LINE
+    mrs x16, CurrentEL
+    str x16, [x17, #40]
+    mrs x16, SCTLR_EL1
+    str x16, [x17, #48]
+    mov x16, #1
+    str x16, [x17]
+    dsb sy
+.endmacro
+
+// Ltrampoline: keep the kernel virtual address it is about to branch to (field [56]).
+.macro SHENG_SMP_RECORD_X0
+    SHENG_SMP_ENTRY_LINE
+    str x0, [x17, #56]
+    dsb sy
+.endmacro
+
+// The reset handler found no cpu data for this MPIDR, or an unexpected handler: keep x0 and stop.
+.macro SHENG_SMP_MARK_GAVE_UP
+    SHENG_SMP_ENTRY_LINE
+    str x0, [x17, #56]
+    mov x16, #0xe0
+    str x16, [x17]
+    dsb sy
+.endmacro
+
+// An early exception on a secondary (Aff1 != 0): record the first one, leaving the boot CPU's shared exception
+// record alone. An external abort on instruction fetch (EC 0x21, IFSC 0x10; seen intermittently on the first
+// fetch at the arm_init_tramp KVA) is retried up to 1024 times after invalidating the TLB and icache, counting in
+// field [56]; anything else, or too many retries, parks the core at stage 0xee. Falls through for the boot CPU.
+// Clobbers x16, x17 and NZCV; ERET restores PSTATE.
+.macro SHENG_SMP_EXCEPTION
+    mrs x16, MPIDR_EL1
+    ubfx x16, x16, #8, #3
+    cbz x16, 9f
+    SHENG_SMP_ENTRY_LINE
+    ldr x16, [x17, #8]
+    cbnz x16, 6f
+    ldr x16, [x17]
+    str x16, [x17, #32]
+    mrs x16, ESR_EL1
+    str x16, [x17, #8]
+    mrs x16, ELR_EL1
+    str x16, [x17, #16]
+    mrs x16, FAR_EL1
+    str x16, [x17, #24]
+    // The table this core walked (replaces the entry-time SCTLR). No AT here: on a secondary it raised a second
+    // exception before anything after it was stored (log F18).
+    mrs x16, TTBR1_EL1
+    str x16, [x17, #48]
+    str xzr, [x17, #40]
+    str xzr, [x17, #56]
+6:
+    mrs x16, ESR_EL1
+    ubfx x16, x16, #26, #6
+    cmp x16, #0x21
+    b.ne 7f
+    mrs x16, ESR_EL1
+    and x16, x16, #0x3f
+    cmp x16, #0x10
+    b.ne 7f
+    ldr x16, [x17, #56]
+    add x16, x16, #1
+    str x16, [x17, #56]
+    cmp x16, #1024
+    b.hs 7f
+    mov x16, #0xee
+    str x16, [x17]
+    dsb sy
+    tlbi vmalle1
+    dsb ish
+    ic iallu
+    dsb ish
+    isb
+    mov x16, #0x10000
+5:
+    subs x16, x16, #1
+    b.ne 5b
+    eret
+7:
+    // Not retried: keep this exception's ESR next to the first one (replaces the entry-time EL).
+    mrs x16, ESR_EL1
+    str x16, [x17, #40]
+    mov x16, #0xee
+    str x16, [x17]
+    dsb sy
+8:
+    wfe
+    b 8b
+9:
+.endmacro
