diff --git a/platform/sheng/macos26/patches/0067-uke-windowserver-crash-report.patch b/platform/sheng/macos26/patches/0067-uke-windowserver-crash-report.patch
new file mode 100644
index 0000000..2db769c
--- /dev/null
+++ b/platform/sheng/macos26/patches/0067-uke-windowserver-crash-report.patch
@@ -0,0 +1,141 @@
+--- a/bsd/kern/kern_exit.c
++++ b/bsd/kern/kern_exit.c
+@@ -2021,12 +2021,138 @@
+ 		    ((proc_getcsflags(p) & CS_KILLED) ? "CS_KILLED" : ""),
+ 		    prefix_str, p->p_exit_reason->osr_namespace, p->p_exit_reason->osr_code,
+ 		    exit_reason_desc ? exit_reason_desc : "none");
++	}
++}
++
++#if SHENG
++#include <stdarg.h>
++#include <mach/shared_region.h>
++#include <vm/vm_shared_region_internal.h>
++extern struct arm_saved_state *find_user_regs(thread_t);
++/*
++ * uke: when WindowServer exits, log what its own crash report would hold: the exit reason with its
++ * description, the shared cache slide, the user frame-pointer backtrace of the exiting thread and the
++ * libsystem_c __crash_info annotations (abort messages). The unslid __crash_info address of the paired
++ * 25F71 cache comes from boot-arg uke-crashinfo (0x1ae5d6c40, 0x148 bytes).
++ */
++static TUNABLE(uint64_t, uke_crashinfo_addr, "uke-crashinfo", 0);
++/* Unslid address of a char * holding an abort message (SkyLight keeps its own: 0x1ae74a558 in 25F71). */
++static TUNABLE(uint64_t, uke_crashmsg_ptr, "uke-crashmsg", 0);
++/* Keep the reports and print them again every 30 s, so they stay inside the retained log tail. */
++static char uke_ws_saved[4096];
++static size_t uke_ws_saved_len;
++static thread_call_t uke_ws_reprint_call;
++static void
++uke_ws_reprint(__unused thread_call_param_t p0, __unused thread_call_param_t p1)
++{
++	if (uke_ws_saved_len) {
++		printf("UKE-WS-SAVED (%zu bytes):\n%s", uke_ws_saved_len, uke_ws_saved);
++	}
++	uint64_t deadline;
++	nanoseconds_to_absolutetime(30ULL * NSEC_PER_SEC, &deadline);
++	thread_call_enter_delayed(uke_ws_reprint_call, mach_absolute_time() + deadline);
++}
++static void
++uke_ws_log(const char *fmt, ...) __printflike(1, 2);
++static void
++uke_ws_log(const char *fmt, ...)
++{
++	char line[300];
++	va_list ap;
++	va_start(ap, fmt);
++	int n = vsnprintf(line, sizeof(line), fmt, ap);
++	va_end(ap);
++	printf("%s", line);
++	if (n > 0 && uke_ws_saved_len + (size_t)n < sizeof(uke_ws_saved)) {
++		memcpy(uke_ws_saved + uke_ws_saved_len, line, (size_t)n);
++		uke_ws_saved_len += (size_t)n;
++		uke_ws_saved[uke_ws_saved_len] = 0;
++	}
++}
++static void
++uke_windowserver_report(proc_t p, int rv)
++{
++	if (!uke_ws_reprint_call) {
++		uke_ws_reprint_call = thread_call_allocate_with_options(uke_ws_reprint, NULL, THREAD_CALL_PRIORITY_LOW, 0);
++		if (uke_ws_reprint_call) {
++			uke_ws_reprint(NULL, NULL);
++		}
++	}
++	char *desc = exit_reason_get_string_desc(p->p_exit_reason);
++	uint32_t slide = 0;
++	vm_shared_region_t sr = vm_shared_region_get(proc_task(p));
++
++	uke_ws_log("UKE-WS: pid %d exit rv=0x%x reason ns=%u code=0x%llx desc=%s\n", proc_getpid(p), rv,
++	    p->p_exit_reason ? p->p_exit_reason->osr_namespace : 0,
++	    p->p_exit_reason ? p->p_exit_reason->osr_code : 0ULL, desc ? desc : "none");
++	if (sr) {
++		mach_vm_offset_t start = 0;
++		if (vm_shared_region_start_address(sr, &start) == KERN_SUCCESS && start >= SHARED_REGION_BASE_ARM64) {
++			slide = (uint32_t)(start - SHARED_REGION_BASE_ARM64);
++		}
++		vm_shared_region_deallocate(sr);
++	}
++	uke_ws_log("UKE-WS: shared cache slide=0x%x\n", slide);
++	arm_saved_state_t *ss = find_user_regs(current_thread());
++	if (ss && is_saved_state64(ss)) {
++		uint64_t fp = get_saved_state_fp(ss);
++		uke_ws_log("UKE-WS: pc=0x%llx lr=0x%llx fp=0x%llx\n", get_saved_state_pc(ss) & 0x7fffffffffULL,
++		    get_saved_state_lr(ss) & 0x7fffffffffULL, fp);
++		for (int i = 0; i < 32 && fp && !(fp & 7); i++) {
++			uint64_t frame[2];
++			if (copyin((user_addr_t)fp, frame, sizeof(frame))) {
++				break;
++			}
++			uke_ws_log("UKE-WS: #%d 0x%llx\n", i, frame[1] & 0x7fffffffffULL);
++			if (frame[0] <= fp) {
++				break;
++			}
++			fp = frame[0];
++		}
++	}
++	if (uke_crashmsg_ptr && slide) {
++		uint64_t message = 0;
++		char text[256];
++		size_t done = 0;
++		if (copyin((user_addr_t)(uke_crashmsg_ptr + slide), &message, sizeof(message)) == 0 && message) {
++			int err = copyinstr((user_addr_t)message, text, sizeof(text), &done);
++			if (err == 0 || done == sizeof(text)) {
++				text[sizeof(text) - 1] = 0;
++				uke_ws_log("UKE-WS: message: %s\n", text);
++			}
++		}
++	}
++	if (uke_crashinfo_addr && slide) {
++		uint64_t annotations[0x148 / 8];
++		if (copyin((user_addr_t)(uke_crashinfo_addr + slide), annotations, sizeof(annotations)) == 0) {
++			for (unsigned i = 0; i + 8 <= 0x148 / 8; i += 8) {
++				/* crashreporter_annotations_t: version, message, signature_string, backtrace, message2, ... */
++				for (unsigned f = 1; f <= 4; f++) {
++					char text[256];
++					size_t done = 0;
++					if (!annotations[i + f] || f == 3) {
++						continue;
++					}
++					if (copyinstr((user_addr_t)annotations[i + f], text, sizeof(text), &done) == 0 ||
++					    done == sizeof(text)) {
++						text[sizeof(text) - 1] = 0;
++						uke_ws_log("UKE-WS: crash_info[%u].%u: %s\n", i / 8, f, text);
++					}
++				}
++			}
++		}
+ 	}
+ }
++#endif
+ 
+ void
+ proc_prepareexit(proc_t p, int rv, boolean_t perf_notify)
+ {
++#if SHENG
++	if (!strncmp(p->p_comm, "WindowServer", sizeof(p->p_comm)) || !strncmp(p->p_comm, "loginwindow", sizeof(p->p_comm))) {
++		uke_windowserver_report(p, rv);
++	}
++#endif
+ 	mach_exception_data_type_t code = 0, subcode = 0, saved_code = 0;
+ 	exception_type_t etype;
+ 
diff --git a/platform/sheng/macos26/patches/0068-uke-ui-page-trace.patch b/platform/sheng/macos26/patches/0068-uke-ui-page-trace.patch
new file mode 100644
index 0000000..9d7b96f
--- /dev/null
+++ b/platform/sheng/macos26/patches/0068-uke-ui-page-trace.patch
@@ -0,0 +1,54 @@
+--- a/osfmk/vm/vm_fault.c
++++ b/osfmk/vm/vm_fault.c
+@@ -8834,6 +8834,31 @@
+  *	4. no longer have a backing store.
+  * Returns FALSE if the page needs to be fully validated.
+  */
++#if SHENG && (DEVELOPMENT || DEBUG)
++extern const char *vnode_getname(struct vnode *);
++extern void vnode_putname(const char *);
++/* uke: trace code-signing validation of the two Recovery UI policy pages that never apply (rules 0, 1). */
++static void
++uke_ui_trace(vm_page_t page, vm_object_t object, const char *where, int extra)
++{
++	if (object->internal || !object->pager || !object->code_signed) {
++		return;
++	}
++	memory_object_offset_t off = page->vmp_offset + object->paging_offset;
++	if (off != 0x6c18000ULL && off != 0xa234000ULL) {
++		return;
++	}
++	struct vnode *vp = vnode_pager_lookup_vnode(object->pager);
++	const char *name = vp ? vnode_getname(vp) : NULL;
++	printf("UKE-UI: %s off=0x%llx file=%s val=0x%x taint=0x%x nx=0x%x wp=%d extra=%d\n", where, off,
++	    name ? name : "?", page->vmp_cs_validated, page->vmp_cs_tainted, page->vmp_cs_nx,
++	    page->vmp_wpmapped, extra);
++	if (name) {
++		vnode_putname(name);
++	}
++}
++#endif
++
+ static boolean_t
+ vm_page_validate_cs_fast(
+ 	vm_page_t       page,
+@@ -8844,6 +8869,9 @@
+ 
