+// uke: with several cores the kernel console takes the framebuffer writer lease for microseconds all the time. Retry the
+// lease instead of abandoning the whole frame on the first collision; stop only if the owner really changed (panic).
+static bool ukeFbBegin(unsigned owner, uint64_t *saved)
+{
+    for (unsigned attempt = 0; attempt < 100000; attempt++) {
+        if (sheng_fb_begin(owner, saved)) return true;
+        if (__atomic_load_n(&sheng_framebuffer.owner, __ATOMIC_ACQUIRE) != owner) return false;
+        __asm__ volatile("yield");
+    }
+    return false;
+}
+static bool ukeFbClaimGui(void)
+{
+    for (unsigned attempt = 0; attempt < 100000; attempt++) {
+        if (sheng_fb_claim_gui()) return true;
+        if (__atomic_load_n(&sheng_framebuffer.owner, __ATOMIC_ACQUIRE) != SHENG_FB_BOOT) return false;
+        __asm__ volatile("yield");
+    }
+    return false;
+}
