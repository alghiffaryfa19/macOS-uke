--- a/osfmk/kern/bsd_kern.c
+++ b/osfmk/kern/bsd_kern.c
@@ -1519,3 +1519,128 @@
 		return KERN_FAILURE;
 	}
 }
+
+#if SHENG
+#include <kern/thread_call.h>
+#include <mach/shared_region.h>
+#include <vm/vm_shared_region_internal.h>
+#include <pexpert/pexpert.h>
+
+/*
+ * uke: with boot-arg uke-sample=1, log the user frame-pointer stacks of the threads of "Language Chooser" every 20 s,
+ * 30 times, after it executes, to see where it waits. Read-only: the process is never stopped or changed. A thread
+ * running in user mode shows its state from its last kernel entry.
+ */
+struct proc;
+extern struct proc *proc_find(int);
+extern int proc_rele(struct proc *);
+extern task_t proc_task(struct proc *);
+
+#define UKE_SAMPLE_THREADS 12
+#define UKE_SAMPLE_FRAMES 24
+#define UKE_SAMPLE_MASK 0x7fffffffffULL
+
+static thread_call_t uke_sample_call;
+static int uke_sample_pid;
+static unsigned uke_sample_rounds;
+
+static void
+uke_sample_task(task_t task)
+{
+	thread_t threads[UKE_SAMPLE_THREADS];
+	unsigned count = 0;
+	thread_t thread;
+	task_lock(task);
+	queue_iterate(&task->threads, thread, thread_t, task_threads) {
+		if (count == UKE_SAMPLE_THREADS) {
+			break;
+		}
+		thread_reference(thread);
+		threads[count++] = thread;
+	}
+	uint64_t image = task->mach_header_vm_address;
+	vm_map_t map = task->map;
+	vm_map_reference(map);
+	task_unlock(task);
+
+	uint64_t slide = 0;
+	vm_shared_region_t sr = vm_shared_region_get(task);
+	if (sr) {
+		mach_vm_offset_t start = 0;
+		if (vm_shared_region_start_address(sr, &start) == KERN_SUCCESS && start >= SHARED_REGION_BASE_ARM64) {
+			slide = start - SHARED_REGION_BASE_ARM64;
+		}
+		vm_shared_region_deallocate(sr);
+	}
+	printf("UKE-SAMPLE: pid %d round %u image 0x%llx cache slide 0x%llx threads %u\n", uke_sample_pid, uke_sample_rounds,
+	    image, slide, count);
+	for (unsigned i = 0; i < count; i++) {
+		struct arm_saved_state *ss = get_user_regs(threads[i]);
+		if (!ss || !is_saved_state64(ss)) {
+			continue;
+		}
+		uint64_t fp = get_saved_state_fp(ss);
+		printf("UKE-SAMPLE: t%u tid %llu state 0x%x pc 0x%llx lr 0x%llx\n", i, thread_tid(threads[i]), threads[i]->state,
+		    get_saved_state_pc(ss) & UKE_SAMPLE_MASK, get_saved_state_lr(ss) & UKE_SAMPLE_MASK);
+		uint64_t frames[UKE_SAMPLE_FRAMES];
+		unsigned depth = 0;
+		while (depth < UKE_SAMPLE_FRAMES && fp && !(fp & 7)) {
+			uint64_t frame[2];
+			if (vm_map_read_user(map, (vm_map_address_t)fp, frame, sizeof(frame)) != KERN_SUCCESS) {
+				break;
+			}
+			frames[depth++] = frame[1] & UKE_SAMPLE_MASK;
+			if (frame[0] <= fp) {
+				break;
+			}
+			fp = frame[0];
+		}
+		for (unsigned f = 0; f < depth; f += 4) {
+			printf("UKE-SAMPLE: t%u #%u 0x%llx 0x%llx 0x%llx 0x%llx\n", i, f, frames[f],
+			    f + 1 < depth ? frames[f + 1] : 0, f + 2 < depth ? frames[f + 2] : 0, f + 3 < depth ? frames[f + 3] : 0);
+		}
+	}
+	for (unsigned i = 0; i < count; i++) {
+		thread_deallocate(threads[i]);
+	}
+	vm_map_deallocate(map);
+}
+
+static void
+uke_sample_tick(__unused thread_call_param_t p0, __unused thread_call_param_t p1)
+{
+	struct proc *p = proc_find(uke_sample_pid);
+	if (!p) {
+		printf("UKE-SAMPLE: pid %d gone\n", uke_sample_pid);
+		return;
+	}
+	uke_sample_task(proc_task(p));
+	proc_rele(p);
+	if (++uke_sample_rounds < 30) {
+		uint64_t deadline;
+		nanoseconds_to_absolutetime(20ULL * NSEC_PER_SEC, &deadline);
+		thread_call_enter_delayed(uke_sample_call, mach_absolute_time() + deadline);
+	}
+}
+
+void uke_sample_exec(const char *comm, int pid);
+void
+uke_sample_exec(const char *comm, int pid)
+{
+	unsigned enabled = 0;
+	if (strcmp(comm, "Language Chooser") || !PE_parse_boot_argn("uke-sample", &enabled, sizeof(enabled)) || !enabled) {
+		return;
+	}
+	if (!uke_sample_call) {
+		uke_sample_call = thread_call_allocate_with_options(uke_sample_tick, NULL, THREAD_CALL_PRIORITY_LOW, 0);
+		if (!uke_sample_call) {
+			return;
+		}
+	}
+	uke_sample_pid = pid;
+	uke_sample_rounds = 0;
+	uint64_t deadline;
+	nanoseconds_to_absolutetime(20ULL * NSEC_PER_SEC, &deadline);
+	thread_call_enter_delayed(uke_sample_call, mach_absolute_time() + deadline);
+}
+#endif /* SHENG */
