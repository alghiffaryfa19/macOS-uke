+static void
+uke_sample_read_names(void)
+{
+	char list[96] = {};
+	unsigned enabled = 0;
+	if (!PE_parse_boot_arg_str("uke-sample-name", list, sizeof(list))) {
+		if (!PE_parse_boot_argn("uke-sample", &enabled, sizeof(enabled)) || !enabled) {
+			return;
+		}
+		strlcpy(list, "Language Chooser", sizeof(list));
+	}
+	for (char *name = list; *name && uke_sample_slot_count < UKE_SAMPLE_SLOTS;) {
+		char *end = name;
+		while (*end && *end != ',') {
+			end++;
+		}
+		bool last = !*end;
+		*end = 0;
+		if (*name) {
+			strlcpy(uke_sample_slots[uke_sample_slot_count++].name, name, sizeof(uke_sample_slots[0].name));
+			printf("UKE-SAMPLE: will sample %s\n", name);
+		}
+		if (last) {
+			break;
+		}
+		name = end + 1;
+	}
