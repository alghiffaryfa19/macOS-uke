+/* uke: extra process names to report, comma separated (boot-arg uke-crash-name=cryptexd,apsd). */
+static bool
+uke_crash_named(const char *comm)
+{
+	char list[128] = "";
+	if (!PE_parse_boot_argn("uke-crash-name", list, sizeof(list))) {
+		return false;
+	}
+	size_t n = strnlen(comm, MAXCOMLEN + 1);
+	for (char *s = list; *s;) {
+		char *e = s;
+		while (*e && *e != ',') {
+			e++;
 		}
+		if ((size_t)(e - s) == n && !strncmp(s, comm, n)) {
+			return true;
+		}
+		s = *e ? e + 1 : e;
 	}
+	return false;
 }
 #endif
 
