diff --git a/ArmCpu.cpp b/ArmCpu.cpp
index a1f7bc6..51ab82d 100644
--- a/ArmCpu.cpp
+++ b/ArmCpu.cpp
@@ -10,6 +10,7 @@
 // Exact private entry from Darwin 23 arm/rtclock.h. Its full data header is
 // not exported to IOKit; the IRQ path calls the real kernel implementation.
 extern "C" void rtclock_intr (unsigned int);
+extern "C" void kprintf (const char *, ...) __printflike(1, 2);
 // Kernel-internal entries used for secondary CPU startup (Darwin 23 osfmk).
 extern "C" vm_offset_t ml_static_vtop (vm_offset_t);
 extern "C" char LowResetVectorBase[], LowResetVectorEnd[], ResetHandlerData[], const_boot_args[];
@@ -170,6 +171,8 @@ static uint64_t gBootAffinity = 0;
 extern "C" {
 volatile uint64_t armcpu_spi_unhandled = 0;
 volatile uint32_t armcpu_spi_unhandled_id = 0;
+volatile uint64_t armcpu_arch_unhandled = 0;   // SGIs/PPIs other than SGI 0 and the timer PPI 27 (hypervisor-raised)
+volatile uint32_t armcpu_arch_unhandled_id = 0;
 }
 
 IOService *ArmCpu::probe (IOService *provider, SInt32 *score)
@@ -598,6 +601,16 @@ void ArmCpu::interrupt (void)
         armcpu_spi_unhandled = armcpu_spi_unhandled + 1;
         armcpu_spi_unhandled_id = intid;
         write32 (gDist, 0x180 + (intid / 32) * 4, 1U << (intid % 32));
+      } else if (intid < 32) {
+        // uke: the Gunyah hypervisor raises SGIs/PPIs of its own (13 on iPadOS 27, 7 on the iOS 17 line). They carry no
+        // work for XNU; acknowledge them like an unclaimed SPI instead of panicking. The first few are logged.
+        // From UniXNU-a27 drivers/ArmCpu 940b493 + f0aa510 (our iPadOS 27 unit build).
+        armcpu_arch_unhandled = armcpu_arch_unhandled + 1;
+        armcpu_arch_unhandled_id = intid;
+        if (armcpu_arch_unhandled <= 8) {
+          kprintf ("ArmCpu: ignored architectural IRQ %u on cpu %u (%llu so far)\n", intid, logicalId,
+                   armcpu_arch_unhandled);
+        }
       } else {
         panic ("ArmCpu: unexpected architectural IRQ %llu", id);
       }
