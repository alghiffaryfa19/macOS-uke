+// uke (2026-11-08): bounce buffers for shared (concurrent) reads, kDataMax each, made on first use and kept. A writer has the window
+// alone and uses the window's own bounce buffer. The lock is made by the first window's configure, before any I/O.
+static IOLock *gUkeBounceLock;
+static uint8_t *gUkeBounce[kReadSlotsMax + 4];
+static uint32_t gUkeBounceBusy;
+static uint8_t *ukeReadBounceTake ()
+{
+  if (!gUkeBounceLock) return nullptr;
+  IOLockLock (gUkeBounceLock);
+  for (;;) {
+    for (uint32_t i = 0; i < kReadSlotsMax + 4; i++) {
+      if (gUkeBounceBusy & (1U << i)) continue;
+      if (!gUkeBounce[i]) gUkeBounce[i] = static_cast<uint8_t *> (IOMalloc (kDataMax));
+      if (!gUkeBounce[i]) continue;
+      gUkeBounceBusy |= 1U << i;
+      IOLockUnlock (gUkeBounceLock);
+      return gUkeBounce[i];
+    }
+    if (!gUkeBounceBusy) { IOLockUnlock (gUkeBounceLock); return nullptr; }   // nothing allocatable and nothing to wait for
+    IOLockSleep (gUkeBounceLock, &gUkeBounceBusy, THREAD_UNINT);
+  }
